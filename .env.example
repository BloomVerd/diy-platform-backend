# Application
STAGE=development
NODE_ENV=development

# Database (PostgreSQL connection URL)
DATABASE_URL=postgresql://user:password@localhost:5432/diy_platform

# Individual DB credentials (used for auto-creating databases on startup)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=diy_platform_dev
DB_NAME_TEST=diy_platform_dev_test

# Redis (BullMQ + cache)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-minimum-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-me-to-another-random-32-char-minimum-secret
JWT_REFRESH_EXPIRY=7d

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=diy-platform-videos

# CDN (CloudFront base URL — no trailing slash)
CDN_BASE_URL=https://d1234567890.cloudfront.net

# Livestream — RTMP ingest base URL (no trailing slash)
# HLS playback URLs are derived from CDN_BASE_URL/live/{streamKey}/index.m3u8
STREAM_INGEST_BASE_URL=rtmp://ingest.example.com/live
